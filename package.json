{
  "name": "pulmonary-picture-id-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "python3 scripts/generate_bank.py",
    "validate": "python3 scripts/validate_bank.py",
    "test": "python3 scripts/validate_bank.py && node --test tests/*.test.mjs",
    "test:visual": "node tests/visual-check.mjs && node tests/visual-check-gaps.mjs && node tests/visual-check-additions.mjs",
